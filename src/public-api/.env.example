# API Keys for Default (Free Tier)
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here
GOOGLE_API_KEY=your-google-ai-studio-key-here

# Security
SECRET_KEY=your-secret-key-generate-with-openssl-rand-hex-32
ADMIN_API_KEY=admin-key-for-usage-stats

# Rate Limiting
REDIS_URL=redis://localhost:6379
FREE_TIER_RATE_LIMIT=100/day

# Database
DATABASE_URL=sqlite+aiosqlite:///./usage.db

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://goat.genomehubs.org

# Environment
ENVIRONMENT=development
DEBUG=true
